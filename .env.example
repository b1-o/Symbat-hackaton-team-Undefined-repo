# Copy to .env. npm run dev / start / llm:check load it automatically when present.
PORT=3000
DB_PATH=./data/startify.db
# Defaults to true outside production, false in production.
DEMO_MODE=true
SEED_DEMO=true
# Required for non-demo organizer login; use a long random secret.
ORGANIZER_PASSWORD=
CHALLENGE_ACCESS_CODE=
APP_ORIGIN=
# 1 only behind exactly one trusted reverse proxy. HTTPS cookies default on in production.
TRUST_PROXY=0
COOKIE_SECURE=true

# SmallThinker via an OpenAI-compatible API. Recommended: llama.cpp.
# Ollama/vLLM require a version that supports the SmallThinker architecture.
# This is a SERVER URL, never exposed to browser code.
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Use the exact model ID returned by your server's /v1/models.
LLM_MODEL=smallthinker
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=900
# none is most portable; json_object/json_schema only if your runtime supports them.
LLM_RESPONSE_FORMAT=none
