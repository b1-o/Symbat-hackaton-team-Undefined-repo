{
  "name": "startify-sprint",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "MVP школьной лиги стартап-спринтов поверх AI Startify: команда, координатор школы и организатор. Symbat Hackathon.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
